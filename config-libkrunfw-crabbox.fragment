# libkrunfw-crabbox — the config fragment this layer appends to libkrunfw v5.6.2's own
# config-libkrunfw_x86_64, before `make olddefconfig` and `make vmlinux`.
#
# One kernel serves two consumers:
#   * in-guest CRIU (LIBKRUN.md §7): CHECKPOINT_RESTORE and the socket diag options;
#   * k3s in a guest (K3S.md §2-§8): the netfilter / x_tables / nft set Services need.
# The stock libkrunfw config disables all of it. A stock kernel gives no ns_last_pid and
# "Diag module missing (-2)", and k3s in a guest loses Services.
#
# `CONFIG_BASE_SMALL=n` is the last row: the stock config sets it, and it is incompatible
# with the per-CPU data some of the above use.
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_INET_DIAG=y
CONFIG_UNIX_DIAG=y
CONFIG_NETLINK_DIAG=y
CONFIG_PACKET_DIAG=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_NUMGEN=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_MARK=y
CONFIG_NETFILTER_XT_MATCH_TCPMSS=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_TARGET_MARK=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=256
CONFIG_IP_VS=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_RR=y
CONFIG_VXLAN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
# CONFIG_BASE_SMALL is not set
